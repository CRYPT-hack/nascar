{
  "name": "interlagos-racer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm-run-all --parallel dev:server dev:client",
    "dev:client": "vite",
    "dev:server": "node --max-old-space-size=96 --import tsx --watch server/index.ts",
    "server": "node --max-old-space-size=96 --import tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "track:build": "tsx track/src/build.ts",
    "loadtest": "tsx tools/loadtest.ts",
    "test": "tsx tools/roomtest.ts && tsx tools/carmeshtest.ts",
    "certs": "bash tools/make-certs.sh"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.14.0",
    "qrcode": "^1.5.4",
    "three": "0.169.0",
    "ws": "8.18.0"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/qrcode": "^1.5.6",
    "@types/three": "0.169.0",
    "@types/ws": "8.5.13",
    "npm-run-all": "4.1.5",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vite": "5.4.11"
  }
}
